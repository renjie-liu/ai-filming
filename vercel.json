{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "front/",
      "framework": "vite",
      "routes": [
        {
          "src": "/(?!assets/|env\\.js$|logo\\.svg$|mockServiceWorker\\.js$|index\\.html$).*",
          "transforms": [{ "type": "request.path", "op": "set", "args": "/index.html" }]
        }
      ]
    },
    "api": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/docs", "destination": { "service": "api" } },
    { "source": "/redoc", "destination": { "service": "api" } },
    { "source": "/openapi.json", "destination": { "service": "api" } },
    { "source": "/assets/(.*)", "destination": { "service": "web" } },
    { "source": "/(env\\.js|logo\\.svg|mockServiceWorker\\.js)", "destination": { "service": "web" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
