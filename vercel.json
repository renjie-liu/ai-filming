{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "front/",
      "framework": "vite"
    },
    "api": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|docs$|redoc$|openapi\\.json$|assets/|env\\.js$|logo\\.svg$|mockServiceWorker\\.js$|index\\.html$).*)",
      "destination": "/index.html"
    },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/docs", "destination": { "service": "api" } },
    { "source": "/redoc", "destination": { "service": "api" } },
    { "source": "/openapi.json", "destination": { "service": "api" } },
    { "source": "/assets/(.*)", "destination": { "service": "web" } },
    { "source": "/(env\\.js|logo\\.svg|mockServiceWorker\\.js)", "destination": { "service": "web" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
